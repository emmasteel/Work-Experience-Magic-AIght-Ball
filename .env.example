# Azure OpenAI Configuration
# Get these values from your Azure Portal: https://portal.azure.com
# Navigate to your Azure OpenAI resource to find these details

# Your Azure OpenAI endpoint URL
# Example: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI API key
# Found in Azure Portal under "Keys and Endpoint" section
AZURE_OPENAI_KEY=your-api-key-here

# The deployment name you created in Azure OpenAI Studio
# This is the name you gave when deploying a model (e.g., gpt-35-turbo, gpt-4)
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Optional: API version (usually leave as default)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Server Configuration
NODE_ENV=development
PORT=3001
